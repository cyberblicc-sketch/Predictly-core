{
  "framework": "nextjs",
  "buildCommand": "bunx prisma generate && bun run build",
  "installCommand": "bun install",
  "regions": ["iad1"],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    }
  ],
  "crons": []
}
